# Copy to .env and edit. Every variable is optional; defaults are shown.

APP_NAME=docs-rag-chatbot
DATA_DIR=./data              # SQLite, ChromaDB and uploaded PDFs live here
DATABASE_URL=                # empty = sqlite in DATA_DIR
SEED_ON_STARTUP=true         # index sample_docs/ on startup
MAX_UPLOAD_MB=20

# LLM (OpenAI-compatible API; Groq free tier by default).
# Leave GROQ_API_KEY empty to run in demo mode (extractive answers, no LLM).
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.1

# Embeddings: sentence-transformers (local model) or hash (offline, keyword-only)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking & retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
# MIN_SCORE=0.2              # unset = 0.2 for MiniLM, 0.05 for hash
